<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ziyada"
           Manufacturer="Ziyada Contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="f7b5e519-7e9b-4e0f-bd2a-8e5f7a1c3d9e"
           Scope="perMachine"
           Compressed="yes">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Ziyada">
        <Component Id="ZiyadaExe" Guid="*">
          <File Id="ZiyadaExeFile" Source="$(var.PublishOutputDir)\Ziyada.exe" KeyPath="yes" />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="Ziyada" Level="1">
      <ComponentRef Id="ZiyadaExe" />
    </Feature>

  </Package>
</Wix>
